<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:padding="24dp">

    <!-- Logo centered near top -->
    <ImageView
        android:id="@+id/iv_welcome_logo"
        android:layout_width="180dp"
        android:layout_height="120dp"
        android:contentDescription="App logo"
        android:src="@drawable/welcome_logo"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- App name -->
    <TextView
        android:id="@+id/tv_app_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="JerseyClub"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#111111"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/iv_welcome_logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tv_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Shop your favorite jerseys"
        android:textSize="14sp"
        android:textColor="#666666"
        android:gravity="center"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tv_app_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Get Started (Register) button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_to_register"
        style="?attr/materialButtonStyle"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="Get Started"
        android:textAllCaps="false"
        android:textColor="#111111"
        android:backgroundTint="#FFFFFF"
        app:cornerRadius="24dp"
        app:strokeColor="#EEEEEE"
        app:strokeWidth="1dp"
        android:elevation="4dp"
        android:layout_marginBottom="56dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.84" />

    <!-- Login button (same style) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_to_login"
        style="?attr/materialButtonStyle"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="Login"
        android:textAllCaps="false"
        android:textColor="#111111"
        android:backgroundTint="#FFFFFF"
        app:cornerRadius="24dp"
        app:strokeColor="#EEEEEE"
        app:strokeWidth="1dp"
        android:elevation="4dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@id/btn_to_register"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.84" />

</androidx.constraintlayout.widget.ConstraintLayout>
